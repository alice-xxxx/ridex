{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "log:default",
    "dialog:default",
    "fs:default",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$DOWNLOAD/**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$APPDATA/**"
        },
        {
          "path": "$RESOURCE/**"
        },
        {
          "path": "$APPCONFIG/**"
        },
        {
          "path": "$APPLOCALDATA/**"
        },
        {
          "path": "$APPCACHE/**"
        },
        {
          "path": "$APPLOG/**"
        },
        {
          "path": "$TEMP/**"
        }
      ]
    }
  ]
}
